<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>

<plugin>
    <!-- Os IDs precisam conter "dark": só assim o Eclipse pede ao GTK a
         variante escura (menus, barra de menus e realces de clique). -->
    <extension point="org.eclipse.e4.ui.css.swt.theme">
        <theme
            id="com.tiago.dbeaver.dracula.theme.dark"
            label="Dracula"
            basestylesheeturi="css/dracula.css">
        </theme>
        <theme
            id="com.tiago.dbeaver.solarized.theme.dark"
            label="Solarized Dark"
            basestylesheeturi="css/solarized-dark.css">
        </theme>
    </extension>
</plugin>
